# Your FPL team (entry) id — the number in fantasy.premierleague.com/entry/<ID>/event/N
FPL_ENTRY_ID=

# FPL login is PingOne OIDC (account.premierleague.com). Email/password login no longer works.
# One-time setup: log in at fantasy.premierleague.com in a browser, open DevTools ->
# Application -> Local Storage / Session Storage, find the `oidc.user:...` entry and copy
# its `refresh_token`. Also copy the token endpoint + client_id from the Network tab
# (the POST to .../as/token). The bot rotates the refresh token and rewrites this file.
FPL_REFRESH_TOKEN=
FPL_TOKEN_URL=https://account.premierleague.com/as/token
FPL_CLIENT_ID=bfcbaf69-aade-4c1b-8f00-c1cb8a193030

# Optional: only needed when judge.enabled = true
ANTHROPIC_API_KEY=
